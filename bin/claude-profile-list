#!/usr/bin/env python3
"""List Claude Code profiles and the account each one is logged into.

Reads account identity straight out of each profile's config files rather than
spawning `claude auth status` per profile, which would cost a full process
launch each time (~500ms vs ~27ms for all profiles).

  <profile>/.api-key             -> API-key auth; contents never printed
  <profile>/.api-base-url        -> gateway/proxy host for an API-key profile
  <profile>/.claude.json         -> oauthAccount.emailAddress
  <profile>/.credentials.json    -> claudeAiOauth.subscriptionType

The default account is the exception: its config lives at ~/.claude.json
(outside the config dir), with credentials in ~/.claude/.credentials.json.

Usage:
  claude-profile-list                 table of all profiles
  claude-profile-list --account NAME  one line: "<email> (<plan>)" for NAME

Environment:
  CLAUDE_PROFILE_ROOT    where profiles live (default ~/.claude-profiles)
  CLAUDE_ACTIVE_PROFILE  which row to mark with '*'; the shell function sets
                         this from the .claude-profile resolved for $PWD
"""

import json
import os
import sys
from urllib.parse import urlparse

HOME = os.path.expanduser("~")
ROOT = os.environ.get("CLAUDE_PROFILE_ROOT", os.path.join(HOME, ".claude-profiles"))
ACTIVE = os.environ.get("CLAUDE_ACTIVE_PROFILE", "")
RESERVED = {"bin"}

ANTHROPIC_HOSTS = {"api.anthropic.com"}


def read_json(path):
    try:
        with open(path) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return {}


def read_line(path):
    """First non-empty line of a file, stripped. '' if unreadable or empty."""
    try:
        with open(path) as fh:
            for line in fh:
                line = line.strip()
                if line:
                    return line
    except OSError:
        pass
    return ""


def paths_for(name):
    """-> (config_json, credentials_json, api_key, api_base_url) for a profile."""
    if name == "default":
        base = os.path.join(HOME, ".claude")
        return (
            os.path.join(HOME, ".claude.json"),
            os.path.join(base, ".credentials.json"),
            os.path.join(base, ".api-key"),
            os.path.join(base, ".api-base-url"),
        )
    base = os.path.join(ROOT, name)
    return (
        os.path.join(base, ".claude.json"),
        os.path.join(base, ".credentials.json"),
        os.path.join(base, ".api-key"),
        os.path.join(base, ".api-base-url"),
    )


def describe(name):
    """-> (account, plan, third_party_host) as display strings.

    third_party_host is the endpoint's hostname when it is not Anthropic's own
    API, else "". Callers decide how to flag it; the table footnotes it.

    An API key wins over stored OAuth credentials, because that is the order the
    launcher applies them: ANTHROPIC_API_KEY set at launch takes precedence over
    whatever .credentials.json still holds. Showing the stale OAuth email for a
    profile that actually bills an API key is the one wrong answer here.
    """
    config_json, credentials_json, api_key, api_base_url = paths_for(name)

    if read_line(api_key):
        url = read_line(api_base_url)
        if not url:
            return "(API key)", "api-key", ""
        host = urlparse(url).hostname or url
        if host in ANTHROPIC_HOSTS:
            return "(API key)", "api-key", ""
        # The host is the whole point of the row: it is where the prompts go.
        return f"(API key -> {host})", "api-key", host

    account = read_json(config_json).get("oauthAccount", {}).get("emailAddress")
    creds = read_json(credentials_json).get("claudeAiOauth", {})
    plan = creds.get("subscriptionType")
    if account:
        return account, (plan or ""), ""
    if creds:
        return "(logged in, account unknown)", (plan or ""), ""
    return "(not logged in)", "", ""


def profile_names():
    names = []
    if os.path.isdir(ROOT):
        for name in sorted(os.listdir(ROOT)):
            if name in RESERVED or not os.path.isdir(os.path.join(ROOT, name)):
                continue
            names.append(name)
    return names


def show_account(name):
    account, plan, third_party = describe(name)
    print(f"{account} ({plan})" if plan else account)
    if third_party:
        print(f"         requests go to {third_party}, not Anthropic's API")


def show_table():
    rows = [(name, *describe(name)) for name in profile_names()]
    rows.append(("default", *describe("default")))

    w_name = max(len(r[0]) for r in rows)
    w_acct = max(len(r[1]) for r in rows)
    w_plan = max(len(r[2]) for r in rows)
    for name, acct, plan, third_party in rows:
        # '*' marks the profile active in the current directory, not the
        # default account — the default is already labelled by name.
        marker = "*" if name == ACTIVE else " "
        # A separate dagger, because the two marks answer different questions:
        # '*' is "does this apply here", the dagger is "where do prompts go".
        flag = " †" if third_party else ""
        suffix = "  <- ~/.claude" if name == "default" else ""
        line = f"  {marker} {name:<{w_name}}  {acct:<{w_acct}}  {plan:<{w_plan}}{flag}{suffix}"
        print(line.rstrip())

    # A non-Anthropic base URL is legitimate — corporate gateways and proxies
    # are a normal setup — but it decides who sees your prompts, so say where
    # they go rather than leaving an unexplained mark in the table.
    if any(r[3] for r in rows):
        print("\n  † routed through a third-party endpoint, not Anthropic's API.")
        print("    Prompts and responses pass through that host.")

    # The whole point of profiles is separate accounts; sharing one is almost
    # always an unfinished setup, so say so rather than letting it look correct.
    seen = {}
    for name, acct, _, _ in rows:
        if "@" in acct:
            seen.setdefault(acct, []).append(name)
    for acct, names in seen.items():
        if len(names) > 1:
            if len(names) == 2:
                joined = " and ".join(names)
            else:
                joined = ", ".join(names[:-1]) + " and " + names[-1]
            # Conversation history is shared across every profile, so it is not
            # something duplicates keep separate — settings and MCP servers are.
            print(f"\n  note: {joined} share the same account ({acct}).")
            print("        Separate settings and MCP servers, but one usage quota.")


def main():
    args = sys.argv[1:]
    if args and args[0] == "--account":
        if len(args) < 2:
            print("usage: claude-profile-list --account <name>", file=sys.stderr)
            return 1
        show_account(args[1])
        return 0
    if args:
        print(f"unknown option: {args[0]}", file=sys.stderr)
        return 1
    show_table()
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except BrokenPipeError:
        sys.exit(0)
